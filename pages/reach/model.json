{
  "about": "sockat の届く範囲の表の正本。issue 2026-11-20-resolve-and-persistent-base の作り直しの案 (置き場 B、link-dir / link-file、fork なし、最終手段なし) に対して作る。表のセルは gen.py がこのデータから計算する。既定の bind は QUESTIONS.md の RS-Q4 の推し b (呼び出しごとの一時ディレクトリを作って消す今の形から fork を除いた形) で作る",
  "params": {
    "rand": {"value": 10, "note": "D・R の乱数の名前 (英数 10 文字)"},
    "B": {"value": 17, "note": "B の名前の長さ。名前は未決 (issue の「案がまだ無い」)。今の名前 sockat.XXXXXXXXXX と同じ 17 バイトで見積もる"},
    "pid": {"value": 7, "note": "procB の <pid> の桁。Linux の pid_max 4194304 で 7 桁 (小さい pid ではその分届くファイル名が延びる)"},
    "fd": {"value": 2, "note": "fd の番号の桁。SPEC の proc の「およそ 79」と同じ 2 桁"},
    "name_max": {"value": 255, "note": "ファイル名の上限 (NAME_MAX)。表のファイル名の帯はここまで"},
    "widened": {"value": 253, "note": "Apple の OS の広げた sockaddr に入るパスの長さ (SPEC の widened)"}
  },

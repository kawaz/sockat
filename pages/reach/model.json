  "evidence": {
    "note": "今の実装 (sockat-rs 0.4 系・sockat-py・sockat-go) を適合試験 (just conformance --no-build --verbose、2026-11-20、全場面で言語の差なし) に流した結果。作り直しで変わらない経路 (unchanged) の行と、fork を持たない言語 (py・go) の既定の bind の行だけに当てる。条件を書いていない次元は、その行で効かない (全部) 時だけ当てる",
    "cases": [
      {"case": "linux-long-bind", "op": "bind", "os": "linux", "when": {"thread_cwd": true, "proc": true}, "filename": 6, "observed": {"rs": "thread-cwd", "py": "thread-cwd", "go": "thread-cwd"}},
      {"case": "no-thread-cwd-bind", "op": "bind", "os": "linux", "when": {"thread_cwd": false, "proc": true}, "filename": 6, "observed": {"rs": "proc", "py": "proc", "go": "proc"}},
      {"case": "no-thread-cwd-bind-kill-unshare", "op": "bind", "os": "linux", "when": {"thread_cwd": false, "proc": true}, "filename": 6, "observed": {"rs": "proc", "py": "proc", "go": "proc"}},
      {"case": "no-proc-bind", "op": "bind", "os": "linux", "when": {"thread_cwd": true, "proc": false}, "filename": 6, "observed": {"rs": "thread-cwd", "py": "thread-cwd", "go": "thread-cwd"}},
      {"case": "no-thread-cwd-no-proc-bind", "op": "bind", "os": "linux", "when": {"thread_cwd": false, "proc": false}, "filename": 6, "observed": {"rs": "fork-cwd", "py": null, "go": null}},

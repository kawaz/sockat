      {"case": "no-thread-cwd-no-proc-bind", "op": "bind", "os": "linux", "when": {"thread_cwd": false, "proc": false}, "filename": 6, "observed": {"rs": "fork-cwd", "py": null, "go": null}},
      {"case": "no-tmpdir-bind", "op": "bind", "os": "linux", "when": {"thread_cwd": true, "proc": true, "tmpdir": "none"}, "filename": 6, "observed": {"rs": "thread-cwd", "py": "thread-cwd", "go": "thread-cwd"}},
